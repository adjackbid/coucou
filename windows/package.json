{
  "name": "coucou-windows",
  "private": true,
  "version": "0.2.19",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p coucou-hook -p coucou-pty -p coucou-team-mcp",
    "prebuild": "cargo build --release -p coucou-hook -p coucou-pty -p coucou-team-mcp",
    "pack": "tauri build && node scripts/pack.mjs",
    "pack:portable": "tauri build && node scripts/portable.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
